{
  "components": {
    "schemas": {
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "csrf": {
            "title": "Csrf",
            "type": "string"
          },
          "kind": {
            "const": "user",
            "title": "Kind",
            "type": "string"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "csrf",
          "account_id",
          "login",
          "name",
          "kind"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "SetupStatus": {
        "properties": {
          "development": {
            "default": false,
            "title": "Development",
            "type": "boolean"
          },
          "setup_available": {
            "default": false,
            "title": "Setup Available",
            "type": "boolean"
          },
          "state": {
            "enum": [
              "setup_required",
              "initialized"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "SetupStatus",
        "type": "object"
      },
      "UploadInput": {
        "additionalProperties": false,
        "properties": {
          "checksum": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Checksum",
            "type": "string"
          },
          "filename": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^/\\\\\\x00-\\x1f]+$",
            "title": "Filename",
            "type": "string"
          },
          "media_type": {
            "enum": [
              "text/plain",
              "application/pdf",
              "image/png",
              "image/jpeg"
            ],
            "title": "Media Type",
            "type": "string"
          },
          "size": {
            "maximum": 10485760.0,
            "minimum": 1.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "media_type",
          "size",
          "checksum"
        ],
        "title": "UploadInput",
        "type": "object"
      },
      "UploadView": {
        "properties": {
          "error": {
            "default": "",
            "title": "Error",
            "type": "string"
          },
          "expires": {
            "title": "Expires",
            "type": "number"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "state": {
            "enum": [
              "pending",
              "queued",
              "quarantined",
              "accepted",
              "rejected",
              "deleting",
              "deleted"
            ],
            "title": "State",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "filename",
          "size",
          "state",
          "expires"
        ],
        "title": "UploadView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {

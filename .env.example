SCHOOL_ENVIRONMENT=development
SCHOOL_DATABASE_URL=postgresql+psycopg://school:school@127.0.0.1:5432/school2036
SCHOOL_REDIS_URL=redis://127.0.0.1:6379/0
SCHOOL_STORAGE_BACKEND=local
SCHOOL_LOCAL_STORAGE_PATH=.data/media
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional private development bucket. Never use production credentials locally.
SCHOOL_R2_ACCOUNT_ID=
SCHOOL_R2_BUCKET=
SCHOOL_R2_ACCESS_KEY_ID=
SCHOOL_R2_SECRET_ACCESS_KEY=

SCHOOL_PUBLIC_ORIGIN=http://localhost:3000
SCHOOL_INSTALLATION_MARKER=.data/installation.json
SCHOOL_ENCRYPTION_KEY_FILE=.data/identity.key

# Upload scanner: use 127.0.0.1 after starting the dev media profile.
SCHOOL_SCANNER_HOST=
SCHOOL_SCANNER_PORT=3310
SCHOOL_MEDIA_QUOTA_BYTES=524288000

# Private study providers. Generate a separate 32+ character RAG service secret.
# Never share these credentials with the browser or commit your real .env.
SCHOOL_RAG_URL=http://127.0.0.1:8081
SCHOOL_RAG_API_KEY=
SCHOOL_GEMINI_API_KEY=
SCHOOL_STUDY_MODEL=gemini-2.5-flash
SCHOOL_STUDY_DAILY_REQUESTS=50
SCHOOL_RAG_SPEND_LIMIT_USD=1
# Optional existing Python 3.12 interpreter; otherwise run make rag-install.
SCHOOL_RAG_PYTHON=

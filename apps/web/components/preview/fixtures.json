  "batch": [
    {
      "q": "A 4 kg cart has a net force of 10 N on it. What is its acceleration (m/s²)?",
      "ans": 2.5,
      "tol": 0.01,
      "why": "a = F / m = 10 / 4 = 2.5 m/s².",
      "mistake": {
        "40": "Multiplied force and mass instead of dividing.",
        "0.4": "Divided mass by force (m/F) instead of F/m."
      }
    },
    {
      "q": "A 60 kg student stands on Earth (g = 9.8 m/s²). What is their weight in newtons?",
      "ans": 588,
      "tol": 1,
      "why": "Weight = m × g = 60 × 9.8 = 588 N. Mass stays 60 kg; weight is a force.",
      "mistake": {
        "60": "Gave the mass (kg) instead of the weight (N). Mass and weight are different quantities."
      }
    },
    {
      "q": "What net force (N) gives a 1200 kg car an acceleration of 3 m/s²?",
      "ans": 3600,
      "tol": 1,
      "why": "F = m × a = 1200 × 3 = 3600 N.",
      "mistake": {
        "400": "Divided mass by acceleration."
      }
    },
    {
      "q": "A 2 kg box is pushed with 15 N while friction is 5 N. What is its acceleration (m/s²)?",
      "ans": 5,
      "tol": 0.01,
      "why": "Net force = 15 − 5 = 10 N, so a = 10 / 2 = 5 m/s².",
      "mistake": {
        "10": "Added friction instead of subtracting it.",
        "7.5": "Used the applied force (15 N) instead of the net force."
      }
    },
    {
      "q": "Same push, but the box mass is doubled to 4 kg. What is the new acceleration (m/s²)?",
      "ans": 2.5,
      "tol": 0.01,
      "why": "Net force is still 10 N; a = 10 / 4 = 2.5 m/s². Doubling mass halves acceleration.",
      "mistake": {
        "10": "Doubled the acceleration instead of halving it."
      }
    }
  ],

SCHOOL_ENVIRONMENT=production
DOMAIN=school.example.org
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS
SCHOOL_DATABASE_URL=postgresql+psycopg://school:REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS@postgres:5432/school2036
SCHOOL_REDIS_URL=redis://redis:6379/0
SCHOOL_STORAGE_BACKEND=r2
SCHOOL_R2_ACCOUNT_ID=REPLACE_ME
SCHOOL_R2_BUCKET=REPLACE_ME
SCHOOL_R2_ACCESS_KEY_ID=REPLACE_ME
SCHOOL_R2_SECRET_ACCESS_KEY=REPLACE_ME

SCHOOL_PUBLIC_ORIGIN=https://REPLACE_WITH_DOMAIN
SCHOOL_INSTALLATION_MARKER=/app/.data/installation.json
SCHOOL_ENCRYPTION_KEY_FILE=/app/.data/identity.key

# Set immutable registry digests before make deploy.
SCHOOL_PYTHON_IMAGE=REPLACE_REGISTRY/school2036-python@sha256:REPLACE_DIGEST
SCHOOL_WEB_IMAGE=REPLACE_REGISTRY/school2036-web@sha256:REPLACE_DIGEST

# Private upload scanner on the internal Compose network.
SCHOOL_SCANNER_HOST=scanner
SCHOOL_SCANNER_PORT=3310
SCHOOL_MEDIA_QUOTA_BYTES=104857600
